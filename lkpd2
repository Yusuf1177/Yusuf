<style>
:root{--bg:#f6f7fb;--card:#fff;--text:#1b1f2a;--muted:#5b6475;--accent:#4f46e5;--accent2:#0ea5e9;--code:#10141f;--codet:#e6e9f5;--ok:#16a34a;--line:#e3e6ef;
