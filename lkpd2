html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:16px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
.hero{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;padding:56px 20px 64px;text-align:center}
.hero h1{margin:0 0 8px;font-size:clamp(1.8rem,5vw,2.8rem);line-height:1.15}
.hero p{margin:4px 0;opacity:.95}
.badges{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:20px}
.badge{background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.4);padding:6px 16px;border-radius:99px;font-weight:600}
nav{position:sticky;top:env(safe-area-inset-top,0px);background:var(--card);border-bottom:1px solid var(--line);z-index:5;display:flex;gap:6px;overflow-x:auto;padding:10px 14px}
nav a{white-space:nowrap;color:var(--muted);text-decoration:none;padding:4px 12px;border-radius:99px;font-size:.9rem}
nav a:hover{background:var(--bg);color:var(--accent)}
main{max-width:860px;margin:0 auto;padding:24px 16px 60px}
section{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px;margin-bottom:20px}
h2{margin:0 0 4px;font-size:1.25rem}
h2 span{color:var(--accent)}
.sub{color:var(--muted);margin:0 0 14px;font-size:.92rem}
pre{background:var(--code);color:var(--codet);padding:14px;border-radius:10px;overflow-x:auto;font:.85rem/1.5 ui-monospace,Menlo,Consolas,monospace;margin:10px 0}
table{border-collapse:collapse;width:100%;margin:10px 0}
th,td{border:1px solid var(--line);padding:8px 12px;text-align:left}
th{background:var(--bg)}
.wrap{overflow-x:auto}
.ans{background:color-mix(in srgb,var(--ok) 12%,transparent);border-left:4px solid var(--ok);padding:10px 14px;border-radius:8px;margin:10px 0}
.ans b{color:var(--ok)}
.bad{border-left-color:#dc2626;background:color-mix(in srgb,#dc2626 10%,transparent)}
.bad b{color:#dc2626}
.demo{background:var(--bg);border:1px dashed var(--accent);border-radius:10px;padding:14px;margin-top:12px}
.demo h4{margin:0 0 8px;color:var(--accent)}
.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:8px}
input{padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:var(--card);color:var(--text);font:inherit;min-width:0;flex:1 1 120px}
button{padding:8px 16px;border:0;border-radius:8px;background:var(--accent);color:#fff;font:inherit;font-weight:600;cursor:pointer}
.out{font-weight:600;white-space:pre-line}
footer{text-align:center;color:var(--muted);padding:24px 16px 40px;font-size:.9rem}
</style>
</head>
